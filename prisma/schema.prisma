generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Akta {
  id              String    @id @default(cuid())
  nomorAkta       String
  tanggal         DateTime
  kategori        String
  jenisAkta       String
  namaNotaris     String
  namaPihak       String
  nik             String?
  npwp            String?
  alamat          String?
  nomorSertifikat String?
  jenisHak        String?
  luasTanah       Float?
  nilaiTransaksi  Float     @default(0)
  nopPbb          String?
  njop            Float     @default(0)
  tanggalSsp      DateTime?
  sspPph          Float     @default(0)
  tanggalBphtb    DateTime?
  bphtb           Float     @default(0)
  honorarium      Float     @default(0)
  status          String    @default("Draft")
  catatan         String?
  detailJson      String    @default("{}")
  pihakJson       String    @default("[]")
  dokumenJson     String    @default("[]")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
